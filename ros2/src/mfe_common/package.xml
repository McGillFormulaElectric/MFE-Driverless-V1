<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mfe_common</name>
  <version>1.1.0</version>
  <description>Shared helpers for the MFE driverless stack: geometry, topic names and QoS profiles</description>
  <maintainer email="fsae@mail.mcgill.ca">ros</maintainer>
  <license>GPL-3.0-only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
